NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# HTTP Basic authentication for the private dashboard.
DASHBOARD_USERNAME=owner
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# One service account can be granted read-only access to all three products.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=sc-domain:denoisebcn.com
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# API/cache behavior.
GOOGLE_ADS_API_VERSION=v25
REPORT_CACHE_TTL_SEC=900
REPORT_MAX_DAYS=366
